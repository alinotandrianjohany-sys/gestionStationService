<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" styleClass="root-container" stylesheets="@../../styles/service.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.dossierService.ServiceController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>

        <!-- BANNIÈRE EN-TÊTE HARMONISÉE -->
        <HBox alignment="CENTER_LEFT" styleClass="pane_gauche_entete">
            <children>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="label-sous-titre-banner" text="GESTION ET TARIFICATION" />
                        <Label styleClass="label-titre-banner" text="Gestion des Services" />
                    </children>
                </VBox>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button onAction="#handleNouveauService" styleClass="btn-action-banner" text="Nouveau Service" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- SECTION PRINCIPALE / TABLEAU -->
        <VBox styleClass="card-pane" VBox.vgrow="ALWAYS" spacing="15.0">
            <children>
                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Label fx:id="lblTotalServices" styleClass="badge-total" text="Total : 0 service(s)" />
                    </children>
                </HBox>

                <TableView fx:id="tableServices" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNom" prefWidth="350.0" text="Nom du Service" />
                        <TableColumn fx:id="colPrix" prefWidth="200.0" text="Prix (AR)" />
                        <TableColumn fx:id="colActions" prefWidth="150.0" text="Actions" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

    </children>
</VBox>