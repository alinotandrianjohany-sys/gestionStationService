<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" stylesheets="@../../styles/service.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.dossierService.NouveauServiceController" prefWidth="400.0">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label fx:id="lblTitreModal" text="Nouveau Service" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>

    <Label fx:id="txtMessage" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" wrapText="true" />

    <VBox spacing="10.0">
        <Label text="Nom du Service :" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtNom" promptText="ex: Vidange"/>

        <Label text="Prix (AR) :" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtPrix" promptText="ex: 35000"/>
    </VBox>

    <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
        <Button text="Annuler" onAction="#handleAnnuler" styleClass="btn-cancel"/>
        <Button text="Enregistrer" onAction="#handleEnregistrer" styleClass="btn-save"/>
    </HBox>
</VBox>