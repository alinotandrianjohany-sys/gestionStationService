<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="580.0" prefWidth="750.0" styleClass="root-container" stylesheets="@../../styles/achat/achat.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.dossierAchat.AchatController">
   <children>
      <VBox spacing="16.0" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="16.0">
         <children>
            <HBox spacing="16.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="16.0" HBox.hgrow="ALWAYS">
                     <children>
                        
                        <!-- Bannière d'en-tête -->
                        <VBox fx:id="pane_gauche_entete" styleClass="pane_gauche_entete">
                           <children>
                              <HBox alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">
                                 <children>
                                    <VBox alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="label-sous-titre-banner" text="OPÉRATIONS ET ACHATS" />
                                          <Label styleClass="label-titre-banner" text="Acheter nos produits locaux" />
                                       </children>
                                    </VBox>
                                    <Button mnemonicParsing="false" onAction="#Btn_afficherFenetreNouveauAchat" styleClass="btn-acheter" text="Nouveau Achat" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- Liste des achats -->
                        <VBox spacing="12.0" styleClass="card-container" VBox.vgrow="ALWAYS">
                           <children>
                              <Label styleClass="label-section" text="Achats effectués" />
                              
                              <TableView fx:id="tableAchats" VBox.vgrow="ALWAYS">
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                                 <columns>
                                    <TableColumn fx:id="num_achat" prefWidth="80.0" text="ID" />
                                    <TableColumn fx:id="num_prod" prefWidth="120.0" text="Produit" />
                                    <TableColumn fx:id="nom_client" prefWidth="150.0" text="Client" />
                                    <TableColumn fx:id="nbr_litre" prefWidth="80.0" text="Litres" />
                                    <TableColumn fx:id="montant_paye_achat" prefWidth="100.0" text="Total" />
                                    <TableColumn fx:id="colAction" prefWidth="100.0" text="Actions" />
                                 </columns>
                              </TableView>
                              
                           </children>
                        </VBox>

                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>