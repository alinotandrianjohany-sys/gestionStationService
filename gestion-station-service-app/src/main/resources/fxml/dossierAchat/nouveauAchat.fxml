<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="root-vbox" stylesheets="@../../styles/achat/nouveauAchat.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.dossierAchat.NouveauAchat">
    <children>
        <Label styleClass="title-label" text="Acheter un Produit" />
        
        <!-- Champ Produit -->
        <VBox spacing="6.0" styleClass="form-group">
            <children>
                <Label text="Numéro du Produit :" />
                <TextField fx:id="txtNumProduit" promptText="Ex : ess-1" />
            </children>
        </VBox>
        
        <!-- Champ Client -->
        <VBox spacing="6.0" styleClass="form-group">
            <children>
                <Label text="Nom du Client :" />
                <TextField fx:id="txtNomClient" promptText="Ex : Rakoto Jean" />
            </children>
        </VBox>
        
        <!-- Type d'achat & Quantité -->
        <VBox spacing="6.0" styleClass="form-group">
            <children>
                <Label text="Type d'achat :" />
                <Label styleClass="subtitle-label" text="Quantité (en litre) / Montant (en Ariary)" />
                <HBox styleClass="form-hbox">
                    <children>
                        <TextField fx:id="txtChoix" styleClass="choix-field" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="ComboTypeAchat" prefWidth="120.0" styleClass="type-combo" />
                    </children>
                </HBox>
            </children>
        </VBox>
                    
        <!-- Bouton Enregistrer -->
        <Button fx:id="BtnEnregistrer" onAction="#Btn_effectuerNouveauAchat" styleClass="btn-submit" text="Enregistrer" />
        
        <!-- Message de notification -->
        <Label fx:id="txtMessage" styleClass="message-label" />
    </children>
</VBox>