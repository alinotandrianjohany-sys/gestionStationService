<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="420.0" spacing="16.0" styleClass="root-vbox" stylesheets="@../../styles/entree/modifierEntree.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.dossierEntree.ModifierEntreeController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        
        <!-- En-tête typographique (Sans pane) -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="form-title" text="Modification Entrée" />
                        <Label styleClass="form-subtitle" text="Mise à jour de la quantité réapprovisionnée" />
                    </children>
                </VBox>
                <Label fx:id="lblDate" styleClass="date-badge" text="18/08/2026" />
            </children>
        </HBox>

        <!-- Numéro d'entrée (Lecture seule) -->
        <VBox spacing="6.0" styleClass="form-group">
            <children>
                <Label styleClass="field-label" text="Numéro d'entrée :" />
                <TextField fx:id="txtNumEntree" editable="false" styleClass="read-only-field" />
            </children>
        </VBox>

        <!-- Produit / Carburant (Lecture seule) -->
        <VBox spacing="6.0" styleClass="form-group">
            <children>
                <Label styleClass="field-label" text="Produit / Carburant :" />
                <TextField fx:id="lblProduit" editable="false" styleClass="read-only-field" />
            </children>
        </VBox>

        <!-- Quantité ajoutée -->
        <VBox spacing="6.0" styleClass="form-group">
            <children>
                <Label styleClass="field-label" text="Quantité ajoutée (Litres / Unités) :" />
                <TextField fx:id="txtStockEntree" promptText="Ex: 500 ou 125.5" styleClass="text-field" />
            </children>
        </VBox>

        <!-- Message d'erreur dynamique -->
        <Label fx:id="lblError" styleClass="error-label" wrapText="true" />

        <!-- Boutons d'action -->
        <HBox spacing="10.0" styleClass="form-hbox">
            <children>
                <Button fx:id="btnAnnuler" maxWidth="1.7976931348623157E308" onAction="#handleAnnuler" styleClass="btn-cancel" text="Annuler" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnValider" maxWidth="1.7976931348623157E308" onAction="#handleValiderEntree" styleClass="btn-primary" text="Enregistrer" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
        
    </children>
</VBox>