<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="650.0" prefWidth="950.0" spacing="20.0" styleClass="main-container" stylesheets="@entree.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.dossierEntree.EntreeController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
      <!-- En-tête -->
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="header-title" text="Gestion des Entrées en Stock" />
                  <Label styleClass="header-subtitle" text="Historique des réapprovisionnements et entrées de carburant" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNouvelleEntree" mnemonicParsing="false" onAction="#handleNouvelleEntree" styleClass="btn-primary" text="+ Nouvelle Entrée" />
         </children>
      </HBox>

      <!-- Barre de recherche et filtres -->
      <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="search-bar-container">
         <children>
            <TextField fx:id="txtRecherche" prefHeight="40.0" prefWidth="350.0" promptText="Rechercher par N° Entrée ou N° Produit..." styleClass="input-search" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblTotalEntrees" styleClass="badge-info" text="Total : 0 entrées" />
         </children>
      </HBox>

      <!-- Tableau des entrées -->
      <TableView fx:id="tableEntree" prefHeight="450.0" prefWidth="900.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colNumEntree" prefWidth="200.0" text="N° Entrée" />
          <TableColumn fx:id="colNumProd" prefWidth="200.0" text="N° Produit" />
            <TableColumn fx:id="colStockEntree" prefWidth="200.0" text="Quantité Entrée (L)" />
            <TableColumn fx:id="colDateEntree" prefWidth="280.0" text="Date &amp; Heure" />
            <TableColumn fx:id="colActions" text="Actions" prefWidth="150.0" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>