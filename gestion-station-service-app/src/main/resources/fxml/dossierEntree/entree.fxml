<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="650.0" prefWidth="950.0" spacing="16.0" styleClass="main-container" stylesheets="@../../styles/entree/entree.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.dossierEntree.EntreeController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      
      <!-- Bannière d'en-tête (25% de la hauteur, Dégradé Menthe Lumineuse) -->
      <VBox fx:id="pane_gauche_entete" styleClass="pane_gauche_entete">
         <children>
            <HBox alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="label-sous-titre-banner" text="HISTORIQUE &amp; RÉAPPROVISIONNEMENT" />
                        <Label styleClass="label-titre-banner" text="Gestion des Entrées en Stock" />
                     </children>
                  </VBox>
                  <Button fx:id="btnNouvelleEntree" mnemonicParsing="false" onAction="#handleNouvelleEntree" styleClass="btn-action-banner" text="+ Nouvelle Entrée" />
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Conteneur Carte : Recherche + Table -->
      <VBox spacing="16.0" styleClass="card-container" VBox.vgrow="ALWAYS">
         <children>
            <!-- Barre de recherche et filtres -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="search-bar-container">
               <children>
                  <TextField fx:id="txtRecherche" prefHeight="40.0" prefWidth="350.0" promptText="Rechercher par N° Entrée ou N° Produit..." styleClass="input-search" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblTotalEntrees" styleClass="badge-info" text="Total : 0 entrées" />
               </children>
            </HBox>

            <!-- Tableau des entrées -->
            <TableView fx:id="tableEntree" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colNumEntree" prefWidth="180.0" text="N° Entrée" />
                  <TableColumn fx:id="colNumProd" prefWidth="180.0" text="N° Produit" />
                  <TableColumn fx:id="colStockEntree" prefWidth="200.0" text="Quantité Entrée (L)" />
                  <TableColumn fx:id="colDateEntree" prefWidth="220.0" text="Date &amp; Heure" />
                  <TableColumn fx:id="colActions" prefWidth="120.0" text="Actions" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>