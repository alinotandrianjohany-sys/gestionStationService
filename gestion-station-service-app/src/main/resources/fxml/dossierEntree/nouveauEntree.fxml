<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="420.0" spacing="16.0" styleClass="root-vbox" stylesheets="@../../styles/entree/nouveau.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.dossierEntree.NouveauEntreeController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        
        <!-- En-tête simple sans pane -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="form-title" text="Nouvelle Entrée Stock" />
                        <Label styleClass="form-subtitle" text="Enregistrement d'un réapprovisionnement" />
                    </children>
                </VBox>
                <Label fx:id="lblDate" styleClass="date-badge" text="18/08/2026" />
            </children>
        </HBox>

        <!-- Numéro d'entrée (Lecture seule) -->
        <VBox spacing="6.0" styleClass="form-group">
            <children>
                <Label styleClass="field-label" text="Numéro d'entrée :" />
                <TextField fx:id="txtNumEntree" editable="false" styleClass="read-only-field" />
            </children>
        </VBox>

        <!-- Sélection du produit -->
        <VBox spacing="6.0" styleClass="form-group">
            <children>
                <Label styleClass="field-label" text="Produit / Carburant :" />
                <ComboBox fx:id="cbProduit" maxWidth="1.7976931348623157E308" promptText="-- Sélectionner un produit --" styleClass="combo-box" />
            </children>
        </VBox>

        <!-- Quantité ajoutée -->
        <VBox spacing="6.0" styleClass="form-group">
            <children>
                <Label styleClass="field-label" text="Quantité ajoutée (Litres) :" />
                <TextField fx:id="txtStockEntree" promptText="Ex: 500 ou 125.5" styleClass="text-field" />
            </children>
        </VBox>

        <!-- Message d'erreur -->
        <Label fx:id="lblError" styleClass="error-label" wrapText="true" />

        <!-- Bouton d'action -->
        <Button fx:id="btnValider" maxWidth="1.7976931348623157E308" onAction="#handleValiderEntree" styleClass="btn-primary" text="Valider l'entrée" />
        
    </children>
</VBox>