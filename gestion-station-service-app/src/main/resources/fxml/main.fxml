<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="950.0" stylesheets="@/styles/main.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.MainController">

	<!-- 1. CÔTÉ GAUCHE : Sidebar Figée -->
	<left>
		<VBox prefWidth="220.0" spacing="10.0" styleClass="sidebar">
			<padding>
				<Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
			</padding>
			<children>
				<Label styleClass="sidebar-title" text="Station Essence" />
				<VBox prefHeight="20.0" /> <!-- Espaceur -->

				<Button fx:id="btnDashboard" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDashboard" styleClass="menu-button" text="Tableau de Bord" />
				<Button fx:id="btnProduits" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleProduits" styleClass="menu-button" text="Produits &amp; Stock" />
				<Button fx:id="btnAchats" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleAchats" styleClass="menu-button" text="Achat" />
				<Button fx:id="btnEntrees" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleEntrees" styleClass="menu-button" text="Entrée" />
				<Button fx:id="btnEntretiens" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleEntretiens" styleClass="menu-button" text="Services &amp; Entretien" />
			</children>
		</VBox>
	</left>

	<!-- 2. PARTIE DROITE : En-tête Fixe + Zone de Contenu Dynamique -->
	<center>
		<VBox prefHeight="200.0" prefWidth="100.0" style="-fx-background-color: #f8fafc;" BorderPane.alignment="CENTER">
			<children>

				<!-- EN-TÊTE FIXE (Style sobre gris clair / titre bleu-gris) -->
				<VBox styleClass="header-banner">
					<padding>
						<Insets bottom="15.0" left="25.0" right="25.0" top="20.0" />
					</padding>
					<children>
						<Label fx:id="lblHeaderTitle" styleClass="header-title" text="Tableau de bord" />
						<Label fx:id="lblHeaderSubtitle" styleClass="header-subtitle" text="Vue d'ensemble de l'activité et des performances" />
					</children>
				</VBox>

				<!-- ZONE D'AFFICHAGE DES COMPOSANTS (Chargement dynamique) -->
				<AnchorPane fx:id="contentArea" VBox.vgrow="ALWAYS">
					<padding>
						<Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
					</padding>
				</AnchorPane>

			</children>
		</VBox>
	</center>
</BorderPane>