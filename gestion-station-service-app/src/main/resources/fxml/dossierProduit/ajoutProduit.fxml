<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<!--Utilisons virtual pour une l'affichage lesy brooo mifampitaingitaingina 
reo amin'izay sa tsy zany :)>-->
<VBox  spacing="15.0" prefWidth="400.0" prefHeight="300.0"
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stationservice.Controller.dossierProduit.AjoutProduitController">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <children>
        <Label text="Ajouter du Produit" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        
        <VBox>
            <Label text="Nom du produit :"/>
            <TextField fx:id="txtNom" promptText="Ex : Essence sans plomb 95"/>
        </VBox>
        
        <VBox>
            <Label text="Prix Unitaire :"/>
            <TextField fx:id="txtPrix" promptText="Ex : 1.50"/>
        </VBox>
        
        <VBox>
            <Label text="Quantite (en litre):"/>
            <TextField fx:id="txtNombreLitre"/>
        </VBox>
                    
        <Button fx:id="BtnEnregistrer" text="Enregistrer" onAction="#handleEnregistrer" maxWidth="Infinity"/>
        
        <Label fx:id="txtMessage"/>
    </children>
</VBox>