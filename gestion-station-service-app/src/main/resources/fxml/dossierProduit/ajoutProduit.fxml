<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="root-vbox" stylesheets="@../../styles/produit/ajoutProduit.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.dossierProduit.AjoutProduitController">
    <children>
        <!-- Titre -->
        <Label styleClass="title-label" text="Ajouter du Produit" />
        
        <!-- Nom du produit -->
        <VBox spacing="6.0" styleClass="form-group">
            <children>
                <Label text="Nom du produit :" />
                <TextField fx:id="txtNom" promptText="Ex : Essence SP95" />
            </children>
        </VBox>
        
        <!-- Prix Unitaire -->
        <VBox spacing="6.0" styleClass="form-group">
            <children>
                <Label text="Prix Unitaire (Ar) :" />
                <TextField fx:id="txtPrix" promptText="Ex : 5900" />
            </children>
        </VBox>
        
        <!-- Quantité -->
        <VBox spacing="6.0" styleClass="form-group">
            <children>
                <Label text="Quantité (en litre) :" />
                <TextField fx:id="txtNombreLitre" promptText="Ex : 1000" />
            </children>
        </VBox>
                    
        <!-- Bouton Enregistrer -->
        <Button fx:id="BtnEnregistrer" onAction="#handleEnregistrer" styleClass="btn-submit" text="Enregistrer" />
        
        <!-- Message de notification -->
        <Label fx:id="txtMessage" styleClass="message-label" />
    </children>
</VBox>