<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>


<VBox  spacing="15.0" prefWidth="400.0" prefHeight="300.0"
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stationservice.Controller.dossierProduit.ModifierProduit">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <children>
        <Label text="Modification de Produit" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        
        <VBox>
            <Label text="Nom du produit :"/>
            <TextField fx:id="txtNom" promptText="Ex : Essence sans plomb 95"/>
        </VBox>
        
        <VBox>
            <Label text="Prix Unitaire :"/>
            <TextField fx:id="txtPrix" promptText="Ex : 1.50"/>
        </VBox>
        
        <VBox>
            <Label text="Quantite (en litre):"/>
            <Label fx:id="txtNombreLitre"/>
        </VBox>
        
        <HBox>
            <Button fx:id="BtnFermer" onAction="#Btn_annulerModification" text="Annuler" prefWidth="100.0"/>
            <Button fx:id="BtnEnregistrer" onAction="#Btn_EnregistrerModification" text="Enregistrer" prefWidth="100.0"/>
        </HBox>
        
        
        <Label fx:id="txtMessage"/>
    </children>
</VBox>