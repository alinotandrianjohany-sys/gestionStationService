<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.stationservice.Controller.dossierEntretien.NewEntretienController"
      prefWidth="400.0">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="New Entretien" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane vgap="10.0" hgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="110.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="N° Entretien :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNumEntretien" promptText="ex: ENT003" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Nom du Client :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNomClient" promptText="ex: RAKOTO Bernard" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Immatriculation :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtImmatriculation" promptText="ex: 3333 FE" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Services :" style="-fx-font-weight: bold;"/>

    <ListView fx:id="listServices" prefHeight="150.0"/>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Label text="Total :" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblTotal" text="0 AR" style="-fx-font-weight: bold; -fx-text-fill: #2a9d8f;"/>
    </HBox>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel"/>
        <Button text="Save" onAction="#handleSave" style="-fx-background-color: #2ab7ca; -fx-text-fill: white;"/>
    </HBox>
</VBox>