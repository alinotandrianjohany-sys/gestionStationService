<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" stylesheets="@../../styles/entretien.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.dossierEntretien.EntretienController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
    <children>

        <!-- Barre d'outils avec boutons bien espaces -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label styleClass="section-title" text="Historique des entretiens réalisés" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleNew" styleClass="btn-action" text="+ Ajouter" />
                <Button onAction="#handleModifierEntretien" styleClass="btn-secondary" text="Modifier" />
                <Button onAction="#handleSupprimerEntretien" styleClass="btn-secondary" text="Supprimer" />
                <Button onAction="#handleImprimerRecu" styleClass="btn-secondary" text="🖨 Reçu PDF" />
            </children>
        </HBox>

        <!-- Tableau principal -->
        <TableView fx:id="tableEntretien" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNumEntr" prefWidth="100.0" text="N° Entretien" />
                <TableColumn fx:id="colImmatriculation" prefWidth="130.0" text="Immatriculation" />
                <TableColumn fx:id="colNomClient" prefWidth="180.0" text="Nom Client" />
                <TableColumn fx:id="colDate" prefWidth="160.0" text="Date &amp; Heure" />
                <TableColumn fx:id="colPrix" prefWidth="120.0" text="Total (Ar)" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </children>
</VBox>