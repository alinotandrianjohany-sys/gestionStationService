<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="root-container" stylesheets="@../../styles/entretien.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.dossierEntretien.EntretienController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>

        <!-- Bannière d'en-tête élégante avec dégradé -->
        <HBox fx:id="pane_gauche_entete" alignment="CENTER_LEFT" styleClass="pane_gauche_entete">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="label-sous-titre-banner" text="GESTION DES ATELIERS" />
                        <Label styleClass="label-titre-banner" text="Historique des entretiens" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button onAction="#handleNew" styleClass="btn-action-banner" text="+ Ajouter" />
                        <Button onAction="#handleModifierEntretien" styleClass="btn-secondary-banner" text="Modifier" />
                        <Button onAction="#handleSupprimerEntretien" styleClass="btn-secondary-banner" text="Supprimer" />
                        <Button onAction="#handleImprimerRecu" styleClass="btn-secondary-banner" text="🖨 Reçu PDF" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Tableau principal moderne -->
        <TableView fx:id="tableEntretien" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNumEntr" prefWidth="100.0" text="N° Entretien" />
                <TableColumn fx:id="colImmatriculation" prefWidth="130.0" text="Immatriculation" />
                <TableColumn fx:id="colNomClient" prefWidth="180.0" text="Nom Client" />
                <TableColumn fx:id="colDate" prefWidth="160.0" text="Date &amp; Heure" />
                <TableColumn fx:id="colPrix" prefWidth="120.0" text="Total (Ar)" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </children>
</VBox>