<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="420.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stationservice.Controller.dossierEntretien.NouveauEntretienController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label fx:id="lblTitreModal" text="Nouvel Entretien">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Separator />

        <GridPane hgap="10.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="240.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
            </rowConstraints>
            <children>
                <Label text="Nom du Client :" />
                <TextField fx:id="txtNomClient" promptText="ex : RAKOTO Bernard" GridPane.columnIndex="1" />

                <Label text="Immatriculation :" GridPane.rowIndex="1" />
                <TextField fx:id="txtImmatriculation" promptText="ex : 3333 FE" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Date &amp; Heure :" GridPane.rowIndex="2" />
                <Label fx:id="lblDateAutomatique" text="--/--/---- --:--" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>

        <Label text="Services à effectuer :" style="-fx-font-weight: bold;" />
        <ScrollPane fitToWidth="true" prefHeight="130.0">
            <content>
                <VBox fx:id="vboxServices" spacing="8.0">
                    <padding>
                        <Insets bottom="5.0" left="10.0" right="5.0" top="5.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Coût Total :" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                <Label fx:id="lblCoutTotal" text="0 Ar" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;" />
            </children>
        </HBox>

        <Label fx:id="txtMessage" textFill="RED" wrapText="true" />

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button onAction="#handleAnnuler" text="Annuler" />
                <Button onAction="#handleEnregistrer" style="-fx-background-color: #00a896;" text="Enregistrer" textFill="WHITE" />
            </children>
        </HBox>
    </children>
</VBox>